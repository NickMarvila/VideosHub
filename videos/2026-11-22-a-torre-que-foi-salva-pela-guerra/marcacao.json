  { "texto": "E sabe o que os engenheiros fizeram para endireitar?", "energia": "calma", "pausa": 0.5, "efeito": "nenhum" },
  { "texto": "Não colocaram nada...", "energia": "calma", "pausa": 0.7, "efeito": "nenhum" },
  { "texto": "Tiraram terra.", "energia": "animada", "pausa": 0.6, "efeito": "risada" },
  { "texto": "E você? Preferia a torre reta ou torta?", "energia": "normal", "pausa": 0, "efeito": "nenhum" }
